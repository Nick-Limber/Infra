{#- Build config as a dict, then render as YAML so quoting is always correct -#}
{%- set cfg = {
  'node-name': rke2_node_name,
  'write-kubeconfig-mode': '0600',
  'cni': rke2_cni,
  'cluster-cidr': rke2_cluster_cidr,
  'service-cidr': rke2_service_cidr,
  'tls-san': ([rke2_api_endpoint, ansible_host | default(inventory_hostname)] + rke2_tls_san) | unique,
} -%}
{%- if not rke2_is_bootstrap -%}
{%-   set _ = cfg.update({'server': 'https://' ~ rke2_api_endpoint ~ ':9345', 'token': rke2_join_token}) -%}
{%- elif rke2_token -%}
{%-   set _ = cfg.update({'token': rke2_token}) -%}
{%- endif -%}
{%- if rke2_control_plane_taint -%}
{%-   set _ = cfg.update({'node-taint': ['CriticalAddonsOnly=true:NoExecute']}) -%}
{%- endif -%}
{%- if rke2_server_node_labels -%}
{%-   set _ = cfg.update({'node-label': rke2_server_node_labels}) -%}
{%- endif -%}
{%- set _ = cfg.update(rke2_server_extra_config) -%}
# Managed by Ansible - changes will be overwritten
{{ cfg | to_nice_yaml(indent=2) }}
