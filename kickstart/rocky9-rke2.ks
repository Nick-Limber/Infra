# =============================================================================
# Rocky Linux 9 kickstart - RKE2 node base install (control plane or worker)
#
# Produces a minimal, Ansible-ready host:
#   - "automation" user, SSH key only, passwordless sudo
#   - root locked, SSH password logins disabled
#   - no swap, SELinux enforcing, firewalld disabled, chrony time sync
#   - dedicated LV for /var/lib/rancher (images + containerd + etcd)
#
# EDIT BEFORE USE:  search for "CHANGEME" (your SSH public key + timezone)
#
# Per-node settings go on the installer boot line (press `e` / Tab at the boot
# menu), so ONE kickstart serves every node:
#
#   inst.ks=http://<web-server>/rocky9-rke2.ks ks_hostname=cp1
#       -> DHCP networking, hostname cp1
#
#   inst.ks=http://<web-server>/rocky9-rke2.ks ks_hostname=worker1 \
#       ks_ip=10.0.0.21 ks_netmask=255.255.255.0 ks_gw=10.0.0.1 ks_dns=10.0.0.1
#       -> static networking (ks_dns may be comma-separated)
#
# Optional: ks_disk=sdb to force the target disk (default: first disk found)
# =============================================================================

# ---- Install source (network install; works from the Rocky 9 boot ISO) ------
url --url="https://download.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/"
repo --name="AppStream" --baseurl="https://download.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/"
# Installing from the full DVD instead? Comment out the two lines above and use:
# cdrom

text
reboot --eject
eula --agreed
firstboot --disabled

# ---- Locale ------------------------------------------------------------------
lang en_US.UTF-8
keyboard --xlayouts='us'
timezone America/Chicago --utc            # CHANGEME if needed
timesource --ntp-server=pool.ntp.org

# ---- Security ----------------------------------------------------------------
selinux --enforcing
firewall --disabled                        # RKE2 recommends firewalld off
rootpw --lock

user --name=automation --groups=wheel --gecos="Automation user" --lock
sshkey --username=automation "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL/BL4+a76FSRkR/IESianftmxrHM7V+bqelhyMnRswF limbern@proton.me"

services --enabled=sshd,chronyd,NetworkManager --disabled=kdump

# ---- Network + disk are generated by %pre from boot parameters ---------------
%include /tmp/network.ks
%include /tmp/disk.ks

# ---- Packages ----------------------------------------------------------------
%packages --inst-langs=en_US
@^minimal-environment
openssh-server
sudo
python3
curl
tar
chrony
container-selinux
policycoreutils-python-utils
iptables-nft
# Storage clients commonly needed by CSI drivers (Longhorn, NFS provisioners)
nfs-utils
iscsi-initiator-utils
# Handy for troubleshooting
bash-completion
lsof
tcpdump
bind-utils
# Not needed on a Kubernetes node
-kexec-tools
-iwl*firmware
%end

%addon com_redhat_kdump --disable
%end

# =============================================================================
%pre --interpreter=/bin/bash --log=/tmp/ks-pre.log
# Read ks_* parameters from the kernel command line
for arg in $(cat /proc/cmdline); do
  case "$arg" in
    ks_hostname=*) KS_HOSTNAME="${arg#*=}" ;;
    ks_ip=*)       KS_IP="${arg#*=}" ;;
    ks_netmask=*)  KS_NETMASK="${arg#*=}" ;;
    ks_gw=*)       KS_GW="${arg#*=}" ;;
    ks_dns=*)      KS_DNS="${arg#*=}" ;;
    ks_disk=*)     KS_DISK="${arg#*=}" ;;
  esac
done
KS_HOSTNAME="${KS_HOSTNAME:-rke2-node}"

# --- Network ---
if [ -n "$KS_IP" ]; then
  echo "network --device=link --bootproto=static --ip=${KS_IP} --netmask=${KS_NETMASK:-255.255.255.0} --gateway=${KS_GW} --nameserver=${KS_DNS:-${KS_GW}} --noipv6 --activate --onboot=yes --hostname=${KS_HOSTNAME}" > /tmp/network.ks
else
  echo "network --device=link --bootproto=dhcp --noipv6 --activate --onboot=yes --hostname=${KS_HOSTNAME}" > /tmp/network.ks
fi

# --- Disk: first non-removable, non-USB disk unless ks_disk= was given ---
if [ -z "$KS_DISK" ]; then
  KS_DISK=$(lsblk -dno NAME,TYPE,RM,TRAN | awk '$2=="disk" && $3=="0" && $4!="usb" {print $1; exit}')
fi

cat > /tmp/disk.ks <<EOF
ignoredisk --only-use=${KS_DISK}
zerombr
clearpart --all --initlabel --drives=${KS_DISK}
bootloader --location=mbr --boot-drive=${KS_DISK} --append="crashkernel=no"
# EFI / BIOS boot partition as appropriate, plus /boot
reqpart --add-boot
part pv.01 --fstype=lvmpv --ondisk=${KS_DISK} --size=1 --grow
volgroup vg_sys pv.01
# NOTE: no swap volume (kubelet expects swap off)
logvol /                --vgname=vg_sys --name=root    --fstype=xfs --size=30720
logvol /var/log         --vgname=vg_sys --name=varlog  --fstype=xfs --size=8192
logvol /var/lib/rancher --vgname=vg_sys --name=rancher --fstype=xfs --size=20480 --grow
EOF

echo "hostname=${KS_HOSTNAME} ip=${KS_IP:-dhcp} disk=${KS_DISK}"
%end

# =============================================================================
%post --interpreter=/bin/bash --log=/root/ks-post.log
set -x

# Passwordless sudo for the automation user (Ansible `become`)
cat > /etc/sudoers.d/automation <<'EOF'
automation ALL=(ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/automation
visudo -cf /etc/sudoers.d/automation

# SSH: keys only, no root login
cat > /etc/ssh/sshd_config.d/10-hardening.conf <<'EOF'
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
EOF
chmod 0600 /etc/ssh/sshd_config.d/10-hardening.conf

# Make sure no swap gets enabled later (zram, swapfiles)
sed -ri '/\sswap\s/s/^#?/#/' /etc/fstab
rm -f /usr/lib/systemd/zram-generator.conf

# Kernel prerequisites (Ansible also does this, but having them from first boot is harmless)
cat > /etc/modules-load.d/rke2.conf <<'EOF'
overlay
br_netfilter
EOF
cat > /etc/sysctl.d/90-rke2.conf <<'EOF'
net.ipv4.ip_forward = 1
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
EOF

# NetworkManager must not manage CNI interfaces
cat > /etc/NetworkManager/conf.d/rke2-canal.conf <<'EOF'
[keyfile]
unmanaged-devices=interface-name:flannel*;interface-name:cali*;interface-name:tunl*;interface-name:vxlan.calico;interface-name:vxlan-v6.calico;interface-name:wireguard.cali;interface-name:wg-v6.cali
EOF

# iSCSI initiator for CSI drivers like Longhorn
systemctl enable iscsid

# Pull in any updates released after the install tree was built
dnf -y update
dnf clean all

# Small marker so you can tell how/when a node was built
echo "Built by rocky9-rke2.ks on $(date -Is)" > /etc/rke2-node-build
%end
